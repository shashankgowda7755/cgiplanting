# Database Configuration
DATABASE_URL=your_database_url_here

# Node Environment (production for Vercel)
NODE_ENV=production

# Session Secret (generate a random string for production)
SESSION_SECRET=your_session_secret_here

# Optional: Port for local development
PORT=3030

# Public legal contact (shown on /privacy and /takedown only when set; use a project-domain inbox)
VITE_CONTACT_EMAIL=
VITE_ORG_POSTAL_ADDRESS=
