{
    "version": 2,
    "buildCommand": "npm run build",
    "installCommand": "npm install",
    "devCommand": "npm run dev",
    "framework": null,
    "builds": [
        {
            "src": "dist/serverless.cjs",
            "use": "@vercel/node"
        },
        {
            "src": "dist/public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/assets/(.*)",
            "dest": "/dist/public/assets/$1"
        },
        {
            "src": "/(.*\\.(js|css|jpg|jpeg|png|svg|ico|webp|gif|woff|woff2|ttf|eot|map|json))",
            "dest": "/dist/public/$1"
        },
        {
            "src": "/api/.*",
            "dest": "/dist/serverless.cjs"
        },
        {
            "src": "/(.*)",
            "dest": "/dist/serverless.cjs"
        }
    ],
    "env": {
        "NODE_ENV": "production"
    }
}